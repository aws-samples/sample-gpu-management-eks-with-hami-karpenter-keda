tools/

# Third-party Helm charts: fetched by scripts/fetch-charts.sh, not vendored
infra/charts/

# Rendered manifests contain a real account ID after substitution
manifests/rendered/

# Local presentation material, not part of the sample
presentation/

# Credentials / kubeconfig — never commit
kubeconfig
*.kubeconfig
*.pem
*.key
credentials

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
